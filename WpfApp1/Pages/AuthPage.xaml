<Page x:Class="WpfApp1.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid Background="#FFEBEC92">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="DMG - Магазин одежды"></TextBlock>
            <TextBlock Text="Вход"></TextBlock>
            <TextBlock Text="Введите логин"></TextBlock>
            <TextBox x:Name="Login" ToolTip="Введите логин"></TextBox>
            <TextBlock Text="Введите пароль"></TextBlock>
            <PasswordBox x:Name="Password" ToolTip="Введите пароль"></PasswordBox>
            <Button x:Name="Enter" Content="Вход"></Button>
            <Button x:Name="EnRegistr" Content="Нет аккаунта? Зарегистрируйтесь"></Button>
        </StackPanel>
    </Grid>
</Page>
