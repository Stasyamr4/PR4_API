<Page x:Class="WpfApp1.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Вход">
    <Grid Background="{StaticResource PageBrush}">
        <Border Style="{StaticResource Card}" Width="400" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="DMG - Магазин одежды" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                <TextBlock Text="Вход" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" Margin="0,4,0,24"/>
                <TextBlock Text="Логин" Style="{StaticResource Label}"/>
                <TextBox x:Name="LoginInput" ToolTip="Введите логин" KeyDown="Input_KeyDown"/>
                <TextBlock Text="Пароль" Style="{StaticResource Label}" Margin="0,14,0,4"/>
                <PasswordBox x:Name="PasswordInput" ToolTip="Введите пароль" KeyDown="Input_KeyDown"/>
                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,12,0,0" Visibility="Collapsed"/>
                <Button x:Name="EnterBtn" Content="Войти" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0" IsDefault="True" Click="Enter_Click"/>
                <Button Content="Нет аккаунта? Зарегистрируйтесь" Style="{StaticResource LinkButton}" Margin="0,8,0,0" Click="Register_Click"/>
                <Button Content="Продолжить как гость" Style="{StaticResource LinkButton}" Foreground="{StaticResource MutedBrush}" Click="Guest_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
