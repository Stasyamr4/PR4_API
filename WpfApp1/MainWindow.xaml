<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DMG — Маркетплейс" Height="780" Width="1200" MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{StaticResource PageBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: кнопки видны в зависимости от роли -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="LogoBtn" Content="DMG · Маркетплейс" FontSize="20" FontWeight="Bold" Style="{StaticResource HeaderButton}" Click="Catalog_Click"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Button Content="Каталог" Style="{StaticResource HeaderButton}" Click="Catalog_Click"/>
                    <Button x:Name="FavoritesBtn" Content="♥ Избранное" Style="{StaticResource HeaderButton}" Click="Favorites_Click"/>
                    <Button x:Name="BasketBtn" Content="🛒 Корзина" Style="{StaticResource HeaderButton}" Click="Basket_Click"/>
                    <Button x:Name="OrdersBtn" Content="Мои заказы" Style="{StaticResource HeaderButton}" Click="Orders_Click"/>
                    <Button x:Name="AdminBtn" Content="⚙ Администрирование" Style="{StaticResource HeaderButton}" Click="Admin_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UserText" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="LoginBtn" Content="Войти" Style="{StaticResource PrimaryButton}" Padding="16,6" Click="Login_Click"/>
                    <Button x:Name="RegisterBtn" Content="Регистрация" Style="{StaticResource HeaderButton}" Click="Register_Click"/>
                    <Button x:Name="LogoutBtn" Content="Выйти" Style="{StaticResource HeaderButton}" Click="Logout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>

        <Border Grid.Row="1" x:Name="ToastBox" Background="#E6111827" CornerRadius="8" Padding="20,10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="14"/>
        </Border>
    </Grid>
</Window>
